# --- PostgreSQL (required) ---
# Create the database first:  createdb hatwan_db
DATABASE_URL="postgresql://user:password@localhost:5432/hatwan_db?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Webhook secret for the "Push Update" non-destructive deploy mechanism
PUSH_UPDATE_SECRET="update-webhook-secret"
