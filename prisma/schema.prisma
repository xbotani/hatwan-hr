generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Core enums
enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  DEPT_HEAD
  EMPLOYEE
  CEO
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Core entities
model Company {
  id          String       @id @default(cuid())
  name        String
  ceoName     String       @default("Mohammed Ahmed Ali")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  branches    Branch[]
  departments Department[]
  users       User[]
  requests    Request[]

  @@map("companies")
}

model Branch {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  name        String
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  users       User[]

  @@map("branches")
}

model Department {
  id        String     @id @default(cuid())
  branchId  String?
  companyId String
  branch    Branch?    @relation(fields: [branchId], references: [id])
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  requests  Request[]

  @@index([companyId, branchId])
  @@map("departments")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  isActive     Boolean   @default(true)
  role         Role       @default(EMPLOYEE)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  requests         Request[]  @relation("RequestedBy")
  reviewedRequests Request[]  @relation("ReviewedBy")

  @@index([companyId, email])
  @@map("users")
}

model Request {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  departmentId   String
  department     Department      @relation(fields: [departmentId], references: [id])
  requesterId    String
  requester      User            @relation("RequestedBy", fields: [requesterId], references: [id])
  itemName        String
  explanation     String
  necessityRating Int
  estimatedCost   Float           @default(0)
  status          RequestStatus   @default(PENDING)
  requestDate    DateTime        @default(now())
  reviewDate     DateTime?
  reviewedBy     String?
  reviewer       User?           @relation("ReviewedBy", fields: [reviewedBy], references: [id])

  @@index([companyId, departmentId, status])
  @@index([requestDate])
  @@map("requests")
}
